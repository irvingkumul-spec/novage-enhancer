// NOVAGE AI • Feedback / memoria colectiva • v4.3.1
// Guardado rápido y robusto: NO usa una segunda respuesta de IA para resumir.
// Guarda directamente una versión anónima y estructurada de la conversación
// confirmada por el cliente y la adjunta a NOVAGE SOLVED CASES.

const KNOWLEDGE_VERSION = "v4.3.1";
const FEEDBACK_LIMIT = 20;
const FEEDBACK_WINDOW_MS = 60 * 60 * 1000;

const feedbackUsage = globalThis.__NOVAGE_FEEDBACK_USAGE__ || new Map();
globalThis.__NOVAGE_FEEDBACK_USAGE__ = feedbackUsage;

function getClientIp(req) {
  const forwarded = req.headers["x-forwarded-for"];
  if (typeof forwarded === "string") return forwarded.split(",")[0].trim();
  return req.socket?.remoteAddress || "unknown";
}

function allowFeedback(ip) {
  const now = Date.now();
  const current = feedbackUsage.get(ip);

  if (!current || now - current.start > FEEDBACK_WINDOW_MS) {
    feedbackUsage.set(ip, { start: now, count: 1 });
    return true;
  }

  if (current.count >= FEEDBACK_LIMIT) return false;

  current.count += 1;
  return true;
}

function redactPII(text) {
  if (!text) return "";

  return String(text)
    .replace(/[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi, "[EMAIL_ELIMINADO]")
    .replace(/(?:\+?\d[\d\s().-]{8,}\d)/g, (match) =>
      match.replace(/\D/g, "").length >= 10 ? "[TELEFONO_ELIMINADO]" : match
    )
    .replace(/\b(?:order|orden|pedido)\s*#?\s*[A-Z0-9-]{4,}\b/gi, "[PEDIDO_ELIMINADO]")
    .replace(/#(?![0-9a-f]{6}\b)[0-9]{5,}\b/gi, "[ID_ELIMINADO]")
    .trim();
}

function sanitizeConversation(conversation) {
  if (!Array.isArray(conversation)) return [];

  return conversation
    .slice(-36)
    .map((item) => {
      const role = item?.role === "assistant" ? "assistant" : "user";
      const text = redactPII(
        typeof item?.text === "string" ? item.text : ""
      ).slice(0, 9000);

      return {
        role,
        text,
        hasImage: Boolean(item?.hasImage),
        responseId:
          typeof item?.responseId === "string" ? item.responseId.slice(0, 512) : null,
        state:
          item?.state === "question"
            ? "question"
            : item?.state === "solution"
            ? "solution"
            : null,
        decision:
          item?.decision &&
          typeof item.decision.question === "string" &&
          Array.isArray(item.decision.options)
            ? {
                key:
                  typeof item.decision.key === "string"
                    ? item.decision.key.slice(0, 80)
                    : "",
                question: redactPII(item.decision.question).slice(0, 800),
                options: item.decision.options
                  .filter((value) => typeof value === "string")
                  .map((value) => redactPII(value).slice(0, 300))
                  .slice(0, 4),
              }
            : null,
        tools: Array.isArray(item?.tools)
          ? item.tools
              .filter((value) => typeof value === "string")
              .map((value) => value.slice(0, 100))
              .slice(0, 12)
          : [],
      };
    })
    .filter((item) => item.text);
}

function lastAssistantMessage(conversation) {
  for (let i = conversation.length - 1; i >= 0; i -= 1) {
    if (conversation[i]?.role === "assistant") return conversation[i];
  }
  return null;
}

function firstUserMessage(conversation) {
  return conversation.find((item) => item.role === "user") || null;
}

function allTools(conversation) {
  return [
    ...new Set(
      conversation.flatMap((item) =>
        Array.isArray(item.tools) ? item.tools : []
      )
    ),
  ];
}

function inferCategory(conversation) {
  const text = conversation.map((item) => item.text).join("\n").toLowerCase();

  if (
    text.includes("foto de playera") ||
    text.includes("foto de camiseta") ||
    text.includes("mockup") ||
    text.includes("diseño plano") ||
    text.includes("referencia")
  ) {
    return "referencia_no_imprimible";
  }

  if (text.includes("borde blanco") || text.includes("halo blanco")) {
    return "bordes_blancos_dtf";
  }

  if (text.includes("semitono")) return "semitonos_dtf";

  if (
    text.includes("pixel") ||
    text.includes("resolución") ||
    text.includes("resolucion") ||
    text.includes("calidad")
  ) {
    return "calidad_imagen";
  }

  if (text.includes("fondo")) return "fondos_dtf";
  if (text.includes("vector")) return "vectorizacion";
  if (text.includes("sublim")) return "sublimacion";
  if (text.includes("vinil")) return "vinil_textil";

  return "soporte_novage";
}

function conversationToText(conversation) {
  return conversation
    .map((item, index) => {
      const who = item.role === "assistant" ? "LUNA" : "CLIENTE";
      const image = item.hasImage ? "\n[Adjuntó una imagen en este turno.]" : "";
      const state = item.state ? `\n[Estado: ${item.state}]` : "";
      const decision = item.decision?.question
        ? `\n[Pregunta decisiva${item.decision.key ? ` / ${item.decision.key}` : ""}: ${
            item.decision.question
          } | Opciones: ${item.decision.options.join(" | ")}]`
        : "";
      const tools = item.tools?.length
        ? `\n[Herramientas NOVAGE: ${item.tools.join(", ")}]`
        : "";

      return `${index + 1}. ${who}:\n${item.text}${image}${state}${decision}${tools}`;
    })
    .join("\n\n");
}

function buildCaseText(conversation, customerNote) {
  const first = firstUserMessage(conversation);
  const last = lastAssistantMessage(conversation);
  const tools = allTools(conversation);
  const category = inferCategory(conversation);
  const note = redactPII(customerNote || "").slice(0, 1800);
  const now = new Date().toISOString();

  return `CASO NOVAGE CONFIRMADO
ESTADO: CLIENTE_CONFIRMÓ_QUE_LE_AYUDÓ
VERSION_MEMORIA: ${KNOWLEDGE_VERSION}
FECHA: ${now}
CATEGORIA: ${category}

PROBLEMA ORIGINAL:
${first?.text || "No disponible."}

ÚLTIMA SOLUCIÓN DE LUNA:
${last?.text || "No disponible."}

COMENTARIO DEL CLIENTE SOBRE QUÉ LE AYUDÓ:
${note || "Sin comentario adicional."}

HERRAMIENTAS NOVAGE MENCIONADAS:
${tools.length ? tools.map((tool) => `- ${tool}`).join("\n") : "- Ninguna"}

CONVERSACIÓN ANÓNIMA CONFIRMADA:
${conversationToText(conversation)}

REGLA DE REUTILIZACIÓN:
Este caso es experiencia confirmada de un cliente, no documentación oficial.
Antes de reutilizar la misma solución con otra persona, Luna debe comprobar que
coincidan las señales relevantes del problema actual.
`;
}

async function deleteOpenAIFile(fileId) {
  if (!fileId) return;

  try {
    await fetch(`https://api.openai.com/v1/files/${encodeURIComponent(fileId)}`, {
      method: "DELETE",
      headers: {
        Authorization: `Bearer ${process.env.OPENAI_API_KEY}`,
      },
    });
  } catch (error) {
    console.error("NOVAGE feedback cleanup error:", error);
  }
}

async function uploadCaseFile(caseText, responseId, customerNote, category) {
  const now = new Date();
  const date = now.toISOString().slice(0, 10).replaceAll("-", "");
  const unique = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
  const filename = `novage-solved-case-${date}-${unique}.txt`;

  const form = new FormData();
  form.append("purpose", "user_data");
  form.append(
    "file",
    new Blob([caseText], { type: "text/plain;charset=utf-8" }),
    filename
  );

  const uploadResponse = await fetch("https://api.openai.com/v1/files", {
    method: "POST",
    headers: {
      Authorization: `Bearer ${process.env.OPENAI_API_KEY}`,
    },
    body: form,
  });

  const uploadData = await uploadResponse.json();

  if (!uploadResponse.ok) {
    throw new Error(
      `FILES_UPLOAD: ${uploadData?.error?.message || "No se pudo subir el archivo."}`
    );
  }

  const attachResponse = await fetch(
    `https://api.openai.com/v1/vector_stores/${encodeURIComponent(
      process.env.NOVAGE_CASES_VECTOR_STORE_ID
    )}/files`,
    {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${process.env.OPENAI_API_KEY}`,
      },
      body: JSON.stringify({
        file_id: uploadData.id,
        attributes: {
          source: "customer_feedback",
          status: "customer_confirmed",
          resolved: true,
          category: String(category || "soporte_novage").slice(0, 60),
          created_date: now.toISOString().slice(0, 10),
          has_customer_note: Boolean(String(customerNote || "").trim()),
          response_id: String(responseId || "unknown").slice(0, 512),
          knowledge_version: KNOWLEDGE_VERSION,
        },
      }),
    }
  );

  const attachData = await attachResponse.json();

  if (!attachResponse.ok) {
    await deleteOpenAIFile(uploadData.id);
    throw new Error(
      `VECTOR_ATTACH: ${
        attachData?.error?.message || "No se pudo adjuntar el caso al Vector Store."
      }`
    );
  }

  if (attachData?.status === "failed") {
    await deleteOpenAIFile(uploadData.id);
    throw new Error(
      `VECTOR_ATTACH: ${
        attachData?.last_error?.message || "OpenAI no pudo indexar el caso."
      }`
    );
  }

  return {
    fileId: uploadData.id,
    filename,
    vectorStoreFileId: attachData.id || uploadData.id,
    status: attachData.status || "in_progress",
  };
}

export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(405).json({ error: "Método no permitido" });
  }

  try {
    if (!process.env.OPENAI_API_KEY) {
      return res.status(500).json({
        error: "OPENAI_API_KEY no está configurada.",
        stage: "config",
      });
    }

    if (!process.env.NOVAGE_CASES_VECTOR_STORE_ID) {
      return res.status(500).json({
        error: "NOVAGE_CASES_VECTOR_STORE_ID no está configurado.",
        stage: "config",
      });
    }

    const { helpful, conversation, responseId, customerNote } = req.body || {};

    if (helpful !== true) {
      return res.status(200).json({
        saved: false,
        message: "La respuesta no se guardó como caso resuelto.",
      });
    }

    if (!allowFeedback(getClientIp(req))) {
      return res.status(429).json({
        error: "Demasiados casos enviados en poco tiempo. Intenta más tarde.",
        stage: "rate_limit",
      });
    }

    const cleanConversation = sanitizeConversation(conversation);
    const hasUser = cleanConversation.some((item) => item.role === "user");
    const hasAssistant = cleanConversation.some((item) => item.role === "assistant");

    if (cleanConversation.length < 2 || !hasUser || !hasAssistant) {
      return res.status(400).json({
        error: "No hay suficiente conversación para crear un caso.",
        stage: "validation",
      });
    }

    const lastAssistant = lastAssistantMessage(cleanConversation);

    if (lastAssistant?.state !== "solution") {
      return res.status(400).json({
        error: "La conversación todavía no contiene una solución final confirmable.",
        stage: "validation",
      });
    }

    const category = inferCategory(cleanConversation);
    const caseText = buildCaseText(cleanConversation, customerNote);

    // Importante: ya NO llamamos otra vez al modelo para resumir.
    // Esto reduce tiempo, costo y elimina el punto de fallo más pesado.
    const saved = await uploadCaseFile(
      caseText,
      responseId,
      customerNote,
      category
    );

    return res.status(200).json({
      saved: true,
      message: "Caso confirmado y añadido a NOVAGE SOLVED CASES.",
      category,
      ...saved,
    });
  } catch (error) {
    console.error("NOVAGE feedback error:", error);

    return res.status(500).json({
      error: "No se pudo guardar el caso resuelto.",
      details: error?.message || "Error desconocido",
      stage:
        String(error?.message || "").startsWith("FILES_UPLOAD")
          ? "files_upload"
          : String(error?.message || "").startsWith("VECTOR_ATTACH")
          ? "vector_attach"
          : "unknown",
    });
  }
}
